# Copiar a .env en el servidor (mismo directorio que docker-compose.prod.yml) y completar.
# Nunca commitear el .env real.

DB_USER=planilla-campo
DB_PASSWORD=<password>
DB_ROOT_PASSWORD=<root-password>

# Al menos 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=<jwt>

# Puerto del host donde escucha la API. 127.0.0.1 = solo accesible vía reverse proxy local.
API_BIND=127.0.0.1
API_PORT=8080
